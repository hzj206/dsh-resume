{
  "name": "dsh-resume",
  "version": "1.0.5",
  "description": "简历 × DeepSeek Harness：本地简历工作台（Markdown DSL 编辑 + A4 实时渲染 + Agent 工具组），无登录、纯本地存储。Local resume workbench for DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "author": "hzj206",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzj206/dsh-resume.git"
  },
  "homepage": "https://github.com/hzj206/dsh-resume#readme",
  "bugs": {
    "url": "https://github.com/hzj206/dsh-resume/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "skills",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "resume",
    "markdown-dsl",
    "workbench",
    "pdf-export"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
